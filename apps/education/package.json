{
  "name": "plip-education",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Chromebook-friendly Plip study companion (student PWA) and teacher summary dashboard. Local synthetic demo mode only.",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "api": "node server/demo-api.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/icons.mjs",
    "test": "node --test tests/*.test.mjs && PLIP_TEST_STORE=sqlite node --test tests/api.test.mjs",
    "e2e": "node tests/e2e.mjs && node tests/e2e-production.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run e2e",
    "shots": "node scripts/shots.mjs",
    "start": "node server/serve.mjs",
    "roster:import": "node server/roster-import.mjs",
    "shots:production": "node scripts/shots-production.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.56.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=22"
  }
}
