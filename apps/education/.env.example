# Plip for school — configuration.
#
# Copy to .env and fill in. NEVER COMMIT THE FILLED-IN COPY: it holds two
# secrets. .gitignore already covers .env; keep it that way.
#
#   PLIP_MODE=demo        fixture sign-in, invented people, memory store.
#                         What `npm run dev` runs. Safe, and useless for real work.
#   PLIP_MODE=production  school SSO, SQLite, a real roster. The process refuses
#                         to start if anything below is missing, and it cannot
#                         read the demo fixtures at all.

PLIP_MODE=production

# ---------------------------------------------------------------------------
# Where it lives
# ---------------------------------------------------------------------------

# The full public URL, no trailing slash. Must be https:// — session cookies are
# Secure and a service worker will not install without TLS. The OIDC redirect
# URI is built from this, so it has to be exactly what the browser sees.
PLIP_PUBLIC_ORIGIN=https://plip.school.example

PLIP_PORT=8080
PLIP_HOST=127.0.0.1

# Behind a reverse proxy (nginx, Caddy, a load balancer)? Then X-Forwarded-For
# is the only real client address, and rate limiting needs to see it.
# Leave this OFF if anything can reach the process directly: the header is one
# anybody can write.
PLIP_TRUST_PROXY=1

# Only for testing the production path on localhost, where there is no TLS.
# Never set this on a host students can reach.
# PLIP_ALLOW_INSECURE=1

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# Signs the session cookie. At least 32 characters.
#   openssl rand -base64 48
# Changing it signs everybody out, which is also how you revoke every session
# at once if you need to.
PLIP_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# SQLite file. Put it on an encrypted volume that is backed up, and remember
# that "delete my data" has to reach those backups too.
PLIP_DATABASE=/var/lib/plip/plip.sqlite

# How long a learning event is kept, in days. Applied on every read and write,
# not by a nightly job that might not run. Keep it as short as the teaching
# actually needs.
PLIP_RETENTION_DAYS=14

# How long a sign-in lasts before the student has to sign in again.
PLIP_SESSION_TTL_HOURS=12

# ---------------------------------------------------------------------------
# Content
# ---------------------------------------------------------------------------

# Your tasks and concepts, as JSON: { "concepts": [...], "tasks": [...] }.
# apps/education/fixtures/catalogue.json shows the shape. It is a demo fixture,
# not curriculum — production will not load it.
PLIP_CATALOGUE=/etc/plip/catalogue.json

# ---------------------------------------------------------------------------
# Who may sign in
# ---------------------------------------------------------------------------

# Google Workspace for Education is https://accounts.google.com. Anything that
# publishes an OpenID discovery document and signs RS256 or ES256 works.
PLIP_OIDC_ISSUER=https://accounts.google.com
PLIP_OIDC_CLIENT_ID=
PLIP_OIDC_CLIENT_SECRET=

# Register exactly this as the redirect URI with your provider:
#   ${PLIP_PUBLIC_ORIGIN}/api/auth/callback
# PLIP_OIDC_REDIRECT_PATH=/api/auth/callback
# PLIP_OIDC_SCOPE=openid email profile

# The email domains your school owns, comma separated. REQUIRED: without it,
# anyone with an account at the provider could sign in.
PLIP_OIDC_ALLOWED_DOMAINS=school.example,students.school.example

# Only people on an imported roster may sign in. Leave this on unless you have
# a reason: with it off, anyone in your domain gets an account (they would have
# no class, so they could only practise privately — but they would exist).
PLIP_REQUIRE_ROSTER=1

# ---------------------------------------------------------------------------
# Rate limiting, per identity per window
# ---------------------------------------------------------------------------
# PLIP_RATE_WINDOW_MS=60000
# PLIP_RATE_READS=600
# PLIP_RATE_WRITES=240

# Where the built app is, if not apps/education/dist.
# PLIP_STATIC_DIR=/srv/plip/dist
